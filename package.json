{
  "name": "buzzystores",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "description": "AI-assisted Local Commerce OS for vendor activation, QR storefronts, campaigns, orders, bookings, and partner reporting.",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "node --test scripts/*.test.mjs",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @buzzystores/database prisma:generate",
    "db:migrate": "pnpm --filter @buzzystores/database prisma:migrate",
    "db:seed": "pnpm --filter @buzzystores/database prisma:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  }
}
