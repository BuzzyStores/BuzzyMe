{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@buzzystores/ai": ["packages/ai/src/index.ts"],
      "@buzzystores/auth": ["packages/auth/src/index.ts"],
      "@buzzystores/config": ["packages/config/src/index.ts"],
      "@buzzystores/database": ["packages/database/src/index.ts"],
      "@buzzystores/notifications": ["packages/notifications/src/index.ts"],
      "@buzzystores/payments": ["packages/payments/src/index.ts"],
      "@buzzystores/types": ["packages/types/src/index.ts"],
      "@buzzystores/ui": ["packages/ui/src/index.ts"],
      "@buzzystores/utils": ["packages/utils/src/index.ts"]
    }
  }
}
